# URL pública do app (sem barra no final)
APP_URL=http://localhost:3000

# AWS — local: perfil do AWS CLI; Vercel: AWS_ROLE_ARN (OIDC) + HUB_AWS_REGION
AWS_PROFILE=default
HUB_AWS_REGION=us-east-1
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/supabase-hub-vercel
DYNAMO_TABLE=supabase-hub

# Cognito (App client com secret e ALLOW_USER_PASSWORD_AUTH)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -base64 32  (exatamente 32 bytes)
TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 32
CRON_SECRET=

# Cadastro público. Fechado por padrão; use true para abrir (self-host: abra para criar a sua conta).
SIGNUP_ENABLED=true
# Com o cadastro fechado, para onde vai o botão "Quero ser avisado" (mailto: ou URL). Opcional.
# ACCESS_REQUEST_URL=mailto:voce@exemplo.com?subject=Acesso

# Planos (só para quem oferece como SaaS; sem isto não há limite nenhum)
# FREE_ORG_LIMIT=2
# Pagamentos AbacatePay (o Pro só abre com PAYMENTS_ENABLED=true + as chaves)
# PAYMENTS_ENABLED=false
# ABACATEPAY_API_KEY=
# ABACATEPAY_WEBHOOK_SECRET=
# ABACATEPAY_PRODUCT_MONTHLY=prod_...
# ABACATEPAY_PRODUCT_YEARLY=prod_...
# ABACATEPAY_ACCEPT_DEV=false

# Supabase OAuth App (Organization Settings > OAuth Apps). Opcional.
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
